# ---------------------------------------------------------------------------
# Vulcaestus — environment template
# Copy to .env and replace every change-me value.
# Generate secrets with: openssl rand -base64 32
# Never commit .env.
# ---------------------------------------------------------------------------

# Database (Docker Compose uses these to create Postgres and build DATABASE_URL)
POSTGRES_USER=vulcaestus
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=vulcaestus
N8N_DB_NAME=n8n

# Public URLs (localhost-only by default)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Sessions and encryption
SESSION_SECRET=change-me-session-secret-at-least-16-chars
SESSION_TTL_HOURS=336
SECRETS_KEY=change-me-encryption-key-at-least-16-chars
SERVICE_API_KEY=change-me-service-key
WEBHOOK_SECRET=change-me-webhook-secret
BROWSER_WORKER_SECRET=change-me-worker-secret
COOKIE_SECURE=false

# Safety. DRY_RUN=true simulates all external actions. Change deliberately.
DRY_RUN=true
RATE_LIMIT_MAX=300
TRUST_PROXY=false

# AI — defaults to a local Ollama model
# qwen2.5:7b-instruct needs ~8-10 GB RAM available to Docker. On smaller hosts use
# qwen2.5:3b-instruct or qwen2.5:1.5b, or configure a hosted provider in Settings.
AI_ENABLED=true
AI_PROVIDER=OLLAMA
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
AI_TIMEOUT_MS=180000

# Notifications (optional)
NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Limits
FOLLOWUP_DAYS=7
MAX_JOBS_PER_DAY=200
MAX_FOLLOWUPS_PER_DAY=20

# Logging
LOG_LEVEL=info

# --- n8n -------------------------------------------------------------------
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
TIMEZONE=Europe/Berlin
# Optional: set after creating your profile to let n8n target it explicitly
DEFAULT_PROFILE_ID=

# --- Browser worker --------------------------------------------------------
HEADLESS=true
WORKER_MAX_CONCURRENT=1
WORKER_ACTION_TIMEOUT_MS=120000

# --- Optional admin bootstrap ---------------------------------------------
# If set, `pnpm db:seed` creates this admin account. Prefer the /setup screen.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_FULL_NAME=

# Internal paths used by Docker (do not change for local dev unless needed)
# PROMPTS_DIR=/app/prompts
# STORAGE_DIR=/data
